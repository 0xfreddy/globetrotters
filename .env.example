REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -hex 32
TRACKING_SECRET=
APP_URL=http://localhost:3000
# Only enable behind a trusted edge that overwrites this header.
# Vercel: x-vercel-ip-country; Cloudflare: cf-ipcountry
TRUSTED_COUNTRY_HEADER=

# Set only on Railway; looks up the trusted X-Real-IP header locally, without storing IPs.
GEOIP_PROVIDER=
