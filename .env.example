REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -hex 32
TRACKING_SECRET=
APP_URL=http://localhost:3000
# Only enable behind a trusted edge that overwrites this header.
# Vercel: x-vercel-ip-country; Cloudflare: cf-ipcountry
TRUSTED_COUNTRY_HEADER=

# Set only on Railway; looks up the trusted X-Real-IP header locally, without storing IPs.
GEOIP_PROVIDER=

# Hosted accounts: requires Clerk keys, Redis, TRACKING_SECRET and HOSTED_ENABLED=true.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional legacy invite registration and operator API secrets.
HOSTED_ENABLED=false
HOSTED_SIGNUP_CODE=
HOSTED_ADMIN_KEY=
HOSTED_MAX_PROJECTS=100
HOSTED_REQUESTS_PER_MINUTE=300
HOSTED_MONTHLY_REQUEST_LIMIT=100000
# Self-hosted customers only: frontend allowed to use /api/collect/self.
SELF_HOSTED_ORIGIN=
# Optional real Railway deploy-template URL for the setup dialog.
RAILWAY_TEMPLATE_URL=

# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=your_posthog_host_here
